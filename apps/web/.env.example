# Copy to .env.local. Leave the Firebase values empty to run fully against the local emulators.
VITE_USE_EMULATORS=true

# Web app config from Firebase console → Project settings → Your apps (not secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=
